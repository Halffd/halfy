---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
    .filter(p => p.data.featured)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    </head>
    <body>
        <Header title={SITE_TITLE} />
        <main>
            <section class="hero">
                <h1>Arc X</h1>
                <p class="subtitle">Full-Stack Developer | Game Engines, AI, Embedded Systems</p>
                <p class="bio">
                    10+ years of programming experience building production software.
                    Specialized in low-level systems programming, game development, and AI integration.
                </p>
                <div class="cta">
                    <a href="mailto:your@email.com" class="btn-primary">Get In Touch</a>
                    <a href="https://github.com/yourusername" class="btn-secondary">GitHub</a>
                </div>
            </section>

            <section class="skills">
                <h2>Core Skills</h2>
                <div class="skill-grid">
                    <div class="skill-card">
                        <h3>Systems Programming</h3>
                        <p>C, C++, Assembly (x86, ARM, RISC-V)</p>
                        <p>OpenGL, SDL2, embedded systems</p>
                    </div>
                    <div class="skill-card">
                        <h3>Web & Mobile</h3>
                        <p>JavaScript, TypeScript, Python, Java</p>
                        <p>React, Node.js, React Native, Flutter</p>
                    </div>
                    <div class="skill-card">
                        <h3>AI & Data</h3>
                        <p>GPT-4 API, OCR, ML basics</p>
                        <p>Firebase, Supabase, SQL, NoSQL</p>
                    </div>
                    <div class="skill-card">
                        <h3>Embedded & Hardware</h3>
                        <p>Arduino, ESP32, STM32</p>
                        <p>I2C, SPI, UART, IoT protocols</p>
                    </div>
                </div>
            </section>

            <section class="featured-projects">
                <h2>Featured Projects</h2>
                <div class="projects-grid">
                    {projects.map((project) => (
                        <article class="project-card">
                            {project.data.heroImage && (
                                <img src={project.data.heroImage} alt={project.data.title} />
                            )}
                            <h3>{project.data.title}</h3>
                            <p>{project.data.description}</p>
                            <div class="tech-tags">
                                {project.data.tech.slice(0, 3).map(tech => (
                                    <span class="tag">{tech}</span>
                                ))}
                            </div>
                            <div class="project-links">
                                <a href={project.data.github}>GitHub</a>
                                {project.data.demo && <a href={project.data.demo}>Demo</a>}
                                <a href={`/projects/${project.id}`}>Details →</a>
                            </div>
                        </article>
                    ))}
                </div>
            </section>

            <section class="experience">
                <h2>Experience Highlights</h2>
                <ul>
                    <li>Built production game engine from scratch (C++/OpenGL)</li>
                    <li>Developed AI chatbot serving 500+ daily users</li>
                    <li>Contributed to open-source browser extension (100k+ users)</li>
                    <li>Compiled Gentoo Linux from source (system administration)</li>
                    <li>Multiple game jam projects (shipped complete games)</li>
                    <li>Embedded systems programming (Arduino, ESP32, firmware)</li>
                </ul>
            </section>
        </main>
        <Footer />
    </body>
</html>

<style>
    .hero {
        text-align: center;
        padding: 4rem 2rem;
        max-width: 800px;
        margin: 0 auto;
    }
    
    .hero h1 {
        font-size: 3rem;
        margin-bottom: 0.5rem;
    }
    
    .subtitle {
        font-size: 1.5rem;
        color: #666;
        margin-bottom: 1.5rem;
    }
    
    .bio {
        font-size: 1.1rem;
        line-height: 1.6;
        margin-bottom: 2rem;
    }
    
    .cta {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }
    
    .btn-primary, .btn-secondary {
        padding: 0.75rem 2rem;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: transform 0.2s;
    }
    
    .btn-primary {
        background: #0066cc;
        color: white;
    }
    
    .btn-secondary {
        background: #f0f0f0;
        color: #333;
    }
    
    .btn-primary:hover, .btn-secondary:hover {
        transform: translateY(-2px);
    }
    
    .skills, .featured-projects, .experience {
        max-width: 1200px;
        margin: 4rem auto;
        padding: 0 2rem;
    }
    
    .skill-grid, .projects-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }
    
    .skill-card, .project-card {
        padding: 1.5rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        background: white;
    }
    
    .skill-card h3, .project-card h3 {
        margin-bottom: 0.5rem;
        color: #0066cc;
    }
    
    .tech-tags {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin: 1rem 0;
    }
    
    .tag {
        background: #e0e0e0;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        font-size: 0.875rem;
    }
    
    .project-links {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }
    
    .project-links a {
        color: #0066cc;
        text-decoration: none;
    }
    
    .experience ul {
        list-style: none;
        padding: 0;
    }
    
    .experience li {
        padding: 0.75rem 0;
        border-bottom: 1px solid #eee;
    }
    
    .experience li:before {
        content: "✓ ";
        color: #0066cc;
        font-weight: bold;
        margin-right: 0.5rem;
    }
</style>