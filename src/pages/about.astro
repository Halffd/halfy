---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title="About" description="About Arc X - Developer background and expertise" />
    </head>
    <body>
        <Header />
        <main>
            <article class="about">
                <h1>About Me</h1>
                
                <section class="intro">
                    <p class="lead">
                        Full-stack developer with 10+ years of programming experience,
                        specializing in systems programming, game engines, AI integration,
                        and embedded systems.
                    </p>
                </section>
                
                <section>
                    <h2>Background</h2>
                    <p>
                        Started programming at age 13 with Python, quickly expanding into
                        C, C++, and assembly language. Self-taught in low-level systems programming,
                        game development, and computer architecture.
                    </p>
                    <p>
                        Currently pursuing Computer Science degree while working on production
                        software and freelance projects. Passionate about understanding how
                        computers work at the lowest levels.
                    </p>
                </section>
                
                <section>
                    <h2>Technical Expertise</h2>
                    
                    <div class="expertise-grid">
                        <div class="expertise-card">
                            <h3>Systems Programming</h3>
                            <ul>
                                <li>C, C++ (10+ years)</li>
                                <li>Assembly (x86, ARM, RISC-V)</li>
                                <li>OpenGL, SDL2, graphics programming</li>
                                <li>Custom language implementation (lexer, parser, AST)</li>
                                <li>Memory management, optimization</li>
                            </ul>
                        </div>
                        
                        <div class="expertise-card">
                            <h3>Web & Mobile Development</h3>
                            <ul>
                                <li>JavaScript, TypeScript, Python</li>
                                <li>React, Node.js, Express</li>
                                <li>React Native, Flutter</li>
                                <li>Android native (Java)</li>
                                <li>Firebase, Supabase integration</li>
                            </ul>
                        </div>
                        
                        <div class="expertise-card">
                            <h3>AI & Machine Learning</h3>
                            <ul>
                                <li>GPT-4 API integration</li>
                                <li>OCR and image processing</li>
                                <li>Natural language processing</li>
                                <li>ML fundamentals (pandas, numpy)</li>
                                <li>Production chatbot development</li>
                            </ul>
                        </div>
                        
                        <div class="expertise-card">
                            <h3>Embedded Systems</h3>
                            <ul>
                                <li>Arduino, ESP32, STM32</li>
                                <li>Firmware development (C/C++)</li>
                                <li>I2C, SPI, UART protocols</li>
                                <li>IoT system design</li>
                                <li>Real-time systems</li>
                            </ul>
                        </div>
                    </div>
                </section>
                
                <section>
                    <h2>Notable Projects</h2>
                    <ul class="projects-list">
                        <li>
                            <strong>Custom Game Engine</strong> - Built complete 2D engine in C++/OpenGL
                            with ECS architecture, physics, and rendering pipeline
                        </li>
                        <li>
                            <strong>AI Chatbot</strong> - Production chatbot serving 500+ users with
                            multi-modal input (text, images,
OCR) and GPT-4 integration
                        </li>
                        <li>
                            <strong>Browser Extension</strong> - Enhanced Yomichan (100k+ users) with
                            custom features and performance optimizations
                        </li>
                        <li>
                            <strong>Custom Programming Language</strong> - Implemented lexer, parser,
                            AST, and interpreter from scratch
                        </li>
                        <li>
                            <strong>Gentoo Linux</strong> - Compiled entire OS from source, deep system
                            administration experience
                        </li>
                    </ul>
                </section>



                <section>
                    <h2>Work Approach</h2>
                    <p>
                        I believe in understanding systems deeply rather than just using them.
                        Whether it's building a game engine from scratch, implementing a custom
                        programming language, or optimizing GPU memory usage, I focus on
                        fundamentals and best practices.
                    </p>
                    <p>
                        My experience spans from the lowest levels (assembly, firmware) to
                        high-level abstractions (AI APIs, web frameworks), giving me a unique
                        perspective on system architecture and optimization.
                    </p>
                </section>



                <section>
                    <h2>Currently Available For</h2>
                    <ul class="availability">
                        <li>Freelance development projects</li>
                        <li>Technical consulting</li>
                        <li>System architecture design</li>
                        <li>Performance optimization</li>
                        <li>Custom software development</li>
                    </ul>
                </section>



                <section class="contact-cta">
                    <h2>Let's Work Together</h2>
                    <p>
                        Interested in working on a project? Have a technical challenge that
                        needs solving? I'm always open to discussing new opportunities.
                    </p>
                    <a href="mailto:your@email.com" class="btn-primary">Get In Touch →</a>
                </section>
            </article>
        </main>
        <Footer />
    </body>
</html>



<style>
    .about {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem;
    }



    .about h1 {
        font-size: 3rem;
        margin-bottom: 2rem;
    }



    .intro {
        margin-bottom: 3rem;
    }



    .lead {
        font-size: 1.4rem;
        line-height: 1.7;
        color: #555;
    }



    section {
        margin-bottom: 3rem;
    }



    section h2 {
        font-size: 2rem;
        margin-bottom: 1.5rem;
        color: #1a1a1a;
    }



    section p {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #444;
        margin-bottom: 1rem;
    }



    .expertise-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }



    .expertise-card {
        background: #f9f9f9;
        padding: 1.5rem;
        border-radius: 8px;
        border-left: 4px solid #0066cc;
    }



    .expertise-card h3 {
        font-size: 1.3rem;
        margin-bottom: 1rem;
        color: #0066cc;
    }



    .expertise-card ul {
        list-style: none;
        padding: 0;
    }



    .expertise-card li {
        padding: 0.4rem 0;
        color: #555;
    }



    .expertise-card li:before {
        content: "▹ ";
        color: #0066cc;
        font-weight: bold;
        margin-right: 0.5rem;
    }



    .projects-list {
        list-style: none;
        padding: 0;
    }



    .projects-list li {
        padding: 1rem 0;
        border-bottom: 1px solid #eee;
    }



    .projects-list li:last-child {
        border-bottom: none;
    }



    .projects-list strong {
        color: #0066cc;
        font-size: 1.1rem;
    }



    .availability {
        list-style: none;
        padding: 0;
    }



    .availability li {
        padding: 0.75rem 0;
        font-size: 1.1rem;
    }



    .availability li:before {
        content: "✓ ";
        color: #00cc66;
        font-weight: bold;
        margin-right: 0.5rem;
    }



    .contact-cta {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 3rem;
        border-radius: 12px;
        text-align: center;
        margin-top: 4rem;
    }



    .contact-cta h2 {
        color: white;
        margin-bottom: 1rem;
    }



    .contact-cta p {
        color: rgba(255,255,255,0.9);
        margin-bottom: 2rem;
        font-size: 1.2rem;
    }



    .btn-primary {
        display: inline-block;
        padding: 1rem 2rem;
        background: white;
        color: #764ba2;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: transform 0.2s;
    }



    .btn-primary:hover {
        transform: translateY(-2px);
    }
</style>